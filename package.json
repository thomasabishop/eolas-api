  "description": "API for querying eolas-db, my Zettelkasten database",
  "license": "ISC",
  "author": "Thomas Bishop",
  "type": "module",
  "imports": {},
  "main": "index.js",
  "scripts": {
    "dev": "NODE_OPTIONS='--experimental-sqlite' node --watch --env-file=.env src/index.js",
